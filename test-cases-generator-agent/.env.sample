# ── Copy to .env and fill in. Blank fields can be supplied via the Settings UI. ──

# Which test-management tool to fetch from: jira | zoho
TRACKER=jira

# Jira Cloud (used when TRACKER=jira)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=ATATT...

# Zoho Sprints (used when TRACKER=zoho)
# Base URL of your Zoho Sprints REST API, e.g. https://sprints.zoho.com/api/v3/team/<teamId>
ZOHO_URL=
ZOHO_TOKEN=

# Which AI provider to generate with: groq | anthropic | copilot
AI_PROVIDER=groq

# Model id (editable in UI). Default Groq model is free.
AI_MODEL=openai/gpt-oss-120b

# Provider API keys
GROQ_KEY=gsk_...
ANTHROPIC_KEY=sk-ant-...
# GitHub token with "models" access (GitHub Models API) — best-effort Copilot path
GITHUB_TOKEN=ghp_...
