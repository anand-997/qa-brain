# Copy this file to .env and fill in your values. .env is gitignored.

# GROQ (required for all generation) — model: openai/gpt-oss-120b (FREE)
GROQ_KEY=""

# Jira Cloud (required only for the "Jira ID" source mode)
JIRA_EMAIL=""
JIRA_API_TOKEN=""   # JIRA_TOKEN is also accepted as a fallback
JIRA_URL=""         # e.g. https://your-domain.atlassian.net

# Optional — Express proxy port (defaults to 8787)
# PORT=8787
